# ─────────────────────────────────────────────
# K 블로그 꾸미기 — 환경 변수 예시 (.env.local 로 복사해서 사용)
# ─────────────────────────────────────────────

# 서비스 주소 (네이버 콜백 URL과 위젯 이미지 주소를 만들 때 사용)
APP_URL=http://localhost:3000

# 세션 서명 키 — 32자 이상 임의 문자열 (예: openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 네이버 로그인 (https://developers.naver.com/apps → 애플리케이션 등록 → 네이버 로그인)
# Callback URL 에는 {APP_URL}/api/auth/naver/callback 을 등록하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# AI (Claude) — https://console.anthropic.com 에서 발급
# 비워두면 AI 없이 '템플릿 모드'로 동작합니다 (데모/개발용).
ANTHROPIC_API_KEY=
# 기본값: claude-opus-5-5 (디자인 생성·이미지 분석 품질 우선)
AI_MODEL=claude-opus-5-5

# 데이터 저장 위치 (SQLite 파일 + 업로드 이미지)
DATA_DIR=./data
# 운영에서 Turso/libSQL 원격 DB를 쓸 경우 (비워두면 DATA_DIR/app.db 사용)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# 개발용 로그인 (네이버 키 없이 로컬 테스트) — 운영 환경에서는 자동으로 비활성화됩니다.
ALLOW_DEV_LOGIN=true

# 사용자당 시간당 AI 호출 한도
AI_RATE_LIMIT_PER_HOUR=30
