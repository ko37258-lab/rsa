{
  "name": "mrk-vr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MR.K-VR · K-영상제작기 — 잘된 유튜브 영상 주소로 분석·제목·썸네일·대본·AI 그림·목소리·자막·MP4 까지 (영상레시피 AI 해부에서 출발)",
  "scripts": {
    "dev": "node scripts/precheck.js && concurrently --kill-others-on-fail -n web,api -c green,cyan \"vite\" \"node server/index.js\"",
    "web": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "demo:render": "node server/cli-demo.js",
    "dev:watch": "concurrently -n web,api -c green,cyan \"vite\" \"node --watch server/index.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "vite": "^6.4.5"
  }
}
