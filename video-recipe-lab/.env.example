# ── 분석·제목·대본: Claude 또는 Gemini (둘 중 하나면 됨) ───────
# 둘 다 비워 두면 데모 모드(준비된 대본)로 동작합니다.
# 스튜디오 화면의 🔑 API 키 등록에서 넣어도 이 파일에 저장됩니다.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# 비워 두면 키로 쓸 수 있는 모델 중 알맞은 것을 자동으로 고릅니다
# GEMINI_MODEL=
# 두 키가 다 있을 때 어느 쪽을 쓸지: claude 또는 gemini
# TEXT_AI=

# ── 그림·음성: OpenAI (선택) ───────────────────────────────
# 없으면 그림은 대체 카드, 음성은 무음(자막만)으로 렌더됩니다.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── 음성: ElevenLabs (선택) ────────────────────────────────
# 키를 넣으면 내 계정의 목소리(기본 + 복제한 목소리)를 자동으로 불러옵니다
ELEVENLABS_API_KEY=
# 목록에 없는 목소리를 직접 추가할 때만: "이름:voiceId,이름:voiceId"
ELEVENLABS_VOICES=

# ── 렌더 설정 ─────────────────────────────────────────────
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# 한글 굵은 폰트 경로 (Windows 기본: C:/Windows/Fonts/malgunbd.ttf 자동 사용)
# FONT_FILE=
# 자막 폰트 이름 (Windows 기본: Malgun Gothic)
# SUBTITLE_FONT=

# 키가 있어도 강제로 데모 모드
# DEMO_MODE=1
PORT=8787
