# ── 텍스트(분석·제목·대본): Claude ─────────────────────────
# 비워 두면 데모 모드(준비된 대본)로 동작합니다.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# ── 그림·음성: OpenAI (선택) ───────────────────────────────
# 없으면 그림은 대체 카드, 음성은 무음(자막만)으로 렌더됩니다.
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ── 음성: ElevenLabs (선택) ────────────────────────────────
ELEVENLABS_API_KEY=
# 쓸 목소리를 "이름:voiceId" 로 쉼표 구분 등록
ELEVENLABS_VOICES=

# ── 렌더 설정 ─────────────────────────────────────────────
# VIDEO_WIDTH=1280
# VIDEO_HEIGHT=720
# 한글 굵은 폰트 경로 (Windows 기본: C:/Windows/Fonts/malgunbd.ttf 자동 사용)
# FONT_FILE=
# 자막 폰트 이름 (Windows 기본: Malgun Gothic)
# SUBTITLE_FONT=

# 키가 있어도 강제로 데모 모드
# DEMO_MODE=1
PORT=8787
