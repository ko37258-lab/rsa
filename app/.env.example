# MR.K 블로그 인사이트 환경변수 예시. 실제 값은 .env.local(커밋 금지)에만 넣습니다.
# 채팅·로그·스크린샷에 비밀값을 붙여넣지 마세요.

# 브라우저에 노출돼도 되는 값은 NEXT_PUBLIC_ 접두사뿐입니다(이 앱은 서버에서만 사용).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서비스 역할 키는 사용하지 않습니다(쓰기는 DB 함수가 권한을 확인).
# 서버 전용 비밀값(절대 NEXT_PUBLIC_ 접두사 금지)
# Aside 수집 API용 토큰. 비워 두면 수집 API가 비활성화(503)됩니다. 32자 이상 무작위 값.
REPORT_INGEST_TOKEN=

# 사이트의 정확한 출처(Origin). 세션 쓰기 요청의 Origin 검사에 사용합니다.
APP_ORIGIN=http://localhost:3000
ALLOWED_BLOG_ID=ko372

# 이 앱은 DEMO_MODE를 지원하지 않습니다. true로 두면 서버가 시작 화면에서 거부합니다.
DEMO_MODE=false

# (테스트 전용) 저장소 밖의 비공개 원자료 폴더 경로. 예: /path/to/MRK_사이트_개발자료
# MRK_DATA_DIR=
