 "sentences": [
  {
   "scene": "intro",
   "s": 0.6,
   "e": 2.293,
   "show": "안녕하세요, 공법의 신 고상철입니다."
  },
  {
   "scene": "intro",
   "s": 2.633,
   "e": 5.328,
   "show": "오늘은 사진 두 장에 담긴 이야기를 풀어 드릴게요."
  },
  {
   "scene": "p1",
   "s": 6.178,
   "e": 9.165,
   "show": "첫 번째 사진은 저의 부동산 실무 강의 현장입니다."
  },
  {
   "scene": "p1",
   "s": 9.505,
   "e": 12.825,
   "show": "강의실을 가득 채운 수강생 모두가 노트북을 펴고 있죠."
  },
  {
   "scene": "p1",
   "s": 13.165,
   "e": 17.482,
   "show": "그냥 듣는 강의가 아니라, 직접 AI를 돌려 보는 실습 강의라서 그렇습니다."
  },
  {
   "scene": "p1",
   "s": 17.822,
   "e": 21.984,
   "show": "맨 앞 노트북 화면을 보시면, 집합건물법 썸네일이 떠 있습니다."
  },
  {
   "scene": "p1",
   "s": 22.324,
   "e": 25.133,
   "show": "주제는 바로 이것, '아파트 복도는 누구의 것일까?'"
  },
  {
   "scene": "p1",
   "s": 25.473,
   "e": 29.04,
   "show": "정답은 공용부분, 구분소유자 모두가 함께 가진 부분이죠."
  },
  {
   "scene": "p1",
   "s": 29.38,
   "e": 32.447,
   "show": "어려운 법률도 AI로 이렇게 한눈에 들어오는 콘텐츠가 됩니다."
  },
  {
   "scene": "p1",
   "s": 32.787,
   "e": 36.167,
   "show": "뒤쪽 삼각대 카메라는 오늘 강의를 영상으로 남기고 있고요."
  },
  {
   "scene": "p1",
   "s": 36.507,
   "e": 40.201,
   "show": "왼쪽 벽 배너에는 '부동산 핵심 실무' 커리큘럼이 걸려 있습니다."
  },
  {
   "scene": "p2a",
   "s": 41.051,
   "e": 44.253,
   "show": "두 번째 사진은 AI로 그려 본 '공법의 신' 작업실입니다."
  },
  {
   "scene": "p2a",
   "s": 44.593,
   "e": 47.643,
   "show": "벽 한가운데, '공법의 신' 네온 간판이 빛나고 있죠."
  },
  {
   "scene": "p2a",
   "s": 47.983,
   "e": 51.151,
   "show": "그 아래 큰 판이 바로 '12p 체계도'입니다."
  },
  {
   "scene": "p2a",
   "s": 51.491,
   "e": 56.163,
   "show": "방대한 공법 조문을 열두 장 체계도로 정리하는 것, 제 강의의 핵심 무기입니다."
  },
  {
   "scene": "p2a",
   "s": 56.503,
   "e": 61.095,
   "show": "국토계획법, 건축법, 주택법처럼 흩어진 법을 한 장씩 구조로 묶었습니다."
  },
  {
   "scene": "p2a",
   "s": 61.435,
   "e": 65.289,
   "show": "왼쪽 간판의 숫자 28은, 공법 강의 28년을 뜻합니다."
  },
  {
   "scene": "p2b",
   "s": 66.139,
   "e": 69.13,
   "show": "오른쪽 화이트보드에는 공법의 기본 공식이 적혀 있습니다."
  },
  {
   "scene": "p2b",
   "s": 69.47,
   "e": 72.678,
   "show": "건폐율은 대지면적에 대한 건축면적의 비율이고요."
  },
  {
   "scene": "p2b",
   "s": 73.018,
   "e": 76.105,
   "show": "용적률은 대지면적에 대한 연면적의 비율입니다."
  },
  {
   "scene": "p2b",
   "s": 76.445,
   "e": 79.095,
   "show": "그리고 용적률 상한은 용도지역마다 다릅니다."
  },
  {
   "scene": "p2b",
   "s": 79.435,
   "e": 81.962,
   "show": "보드에 적힌 숫자는 그림 속 예시일 뿐입니다."
  },
  {
   "scene": "p2b",
   "s": 82.302,
   "e": 87.054,
   "show": "국토계획법이 정한 상한은 주거 500, 상업 1,500, 공업 400% 이하입니다."
  },
  {
   "scene": "p2c",
   "s": 87.904,
   "e": 91.864,
   "show": "책상 위 모니터 세 대는 AI 분석, 부동산 거래동향, 영상 편집 화면입니다."
  },
  {
   "scene": "p2c",
   "s": 92.204,
   "e": 95.157,
   "show": "링라이트와 카메라, 마이크는 유튜브 촬영 장비고요."
  },
  {
   "scene": "p2c",
   "s": 95.497,
   "e": 100.337,
   "show": "부동산 AI학과 교수로서, 강의와 유튜브를 AI와 함께 만들고 있습니다."
  },
  {
   "scene": "p2d",
   "s": 101.187,
   "e": 103.799,
   "show": "오른쪽 지도는 미스터홈즈 프랜차이즈 지점망입니다."
  },
  {
   "scene": "p2d",
   "s": 104.139,
   "e": 107.548,
   "show": "서울부터 제주까지, 전국 100여 개 지점이 함께하고 있죠."
  },
  {
   "scene": "p2d",
   "s": 107.888,
   "e": 112.172,
   "show": "위쪽 액자는 박사·석사 학위증, 그리고 '법은 사람을 위한 것이다'라는 글귀입니다."
  },
  {
   "scene": "p2e",
   "s": 113.022,
   "e": 117.277,
   "show": "바닥에는 국토계획법, 건축법, 주택법 교재가 산처럼 쌓여 있고요."
  },
  {
   "scene": "p2e",
   "s": 117.617,
   "e": 120.335,
   "show": "오른쪽엔 합격증과 '감사합니다' 편지가 가득합니다."
  },
  {
   "scene": "p2e",
   "s": 120.675,
   "e": 124.425,
   "show": "풍선과 꽃가루는 수강생들의 합격을 함께 축하하는 장면이죠."
  },
  {
   "scene": "outro",
   "s": 125.275,
   "e": 128.305,
   "show": "훌륭한 의사는 한 시간에 한 사람의 생명을 구할 수 있지만,"
  },
  {
   "scene": "outro",
   "s": 128.645,
   "e": 132.451,
   "show": "훌륭한 선생은 한 시간에 | 수만 명의 인생을 바꿀 수 있습니다."
