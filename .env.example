# 메타 개발자 콘솔 > 앱 > "Threads 사용" 에서 확인
# 주의: 여기 있는 App ID는 "Threads 앱 ID"를 써야 합니다 (일반 앱 ID 아님).
THREADS_APP_ID=여기에_Threads_앱_ID
THREADS_APP_SECRET=여기에_앱_시크릿

# 앱 설정에 등록한 리디렉트 URI와 정확히 일치해야 합니다.
THREADS_REDIRECT_URI=https://localhost/callback

# (선택) 권한 스코프. 비워두면 기본 4개가 적용됩니다.
# threads_basic,threads_content_publish,threads_manage_replies,threads_read_replies
THREADS_SCOPES=

# ---------------------------------------------------------------
# 릴스 오토파일럿
# ---------------------------------------------------------------
# (선택) Claude API 키. 넣으면 훅 제목·카드 문구·캡션·해시태그·대본을 AI 가 다듬습니다.
# 없어도 편집은 끝까지 돌고, 문구는 규칙으로 만듭니다. 화면의 '설정' 탭에서도 넣을 수 있어요.
ANTHROPIC_API_KEY=

# (선택) 작업폴더 위치. 비우면 프로그램 폴더 안 '작업폴더'
REELS_WORKSPACE=

# (선택) 인터넷 없는 곳에 설치할 때: 미리 받아 둔 받아쓰기 모델 폴더 / ffmpeg 실행 파일
WHISPER_MODEL_DIR=
FFMPEG_BIN=
